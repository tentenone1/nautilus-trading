[Unit]
Description=Nautilus Polymarket Whale Follower (Paper Trading)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=elon-1
Group=elon-1
WorkingDirectory=/home/elon-1/workspace/nautilus-trading
ExecStart=/home/elon-1/workspace/nautilus-trading/venv/bin/python run_paper.py
Restart=on-failure
RestartSec=30
StartLimitBurst=5
StartLimitIntervalSec=300
StandardOutput=append:/home/elon-1/workspace/nautilus-trading/dashboard.log
StandardError=append:/home/elon-1/workspace/nautilus-trading/dashboard.log

# Environment
Environment="PYTHONUNBUFFERED=1"

# Resource limits
LimitNOFILE=65536
LimitCORE=unlimited   # Core dumps on SIGABRT for Rust backtrace analysis
# MemoryMax=4G removed — caused cgroup OOM kills misdiagnosed as crashes.
# The system has 15GB RAM; let the OS manage it naturally with swap.

[Install]
WantedBy=default.target
